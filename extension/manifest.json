{
  "manifest_version": 3,
  "name": "통학 알리미",
  "version": "0.2.4",
  "description": "오늘 남은 수업 · 다음 수업 카운트다운 · 수업 시작 전 알림",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "통학 알리미",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["http://101.79.26.150/*"]
}
