{
  "_설명": "calc.js 와 calc.py 가 같은 결과를 내는지 확인하는 공용 케이스. 실행: python3 server/test_calc.py. 시각 기대값은 label 형식(전날 · 다음날 포함), 버스 노선은 예시 데이터(실제 시간표 아님).",
  "routes": {
    "A": { "rideMin": 40, "times": {
      "weekday":  ["06:40", "07:25", "08:05", "08:45", "09:30", "10:30", "12:00", "13:30", "15:00", "17:00", "19:00", "21:00"],
      "saturday": ["07:30", "08:30", "10:00", "12:00", "15:00", "18:00"],
      "sunday":   ["08:00", "11:00", "14:00", "17:00"] } },
    "C": { "rideMin": 55, "times": {
      "weekday":  ["07:10", "08:20", "10:00", "13:00", "16:00", "18:30"],
      "saturday": ["08:00", "12:00", "17:00"],
      "sunday":   ["09:00", "15:00"] } },
    "NIGHT": { "rideMin": 30, "times": { "weekday": ["00:20", "05:00"], "saturday": [], "sunday": [] } },
    "WEEKDAY_ONLY": { "rideMin": 30, "times": { "weekday": ["08:00"], "saturday": [], "sunday": [] } }
  },
  "commute": { "prepMin": 40, "walkToStopMin": 5, "walkToRoomMin": 8, "bufferMin": 0 },
  "cases": [
    { "name": "1. 기획서 예시", "fn": "calcDay", "route": "A", "day": 1,
      "classes": [{ "day": 1, "start": "09:00", "end": "10:15", "name": "자료구조" }],
      "expect": { "status": "ok", "bus": "08:05", "departure": "08:00", "wake": "07:20", "lateMin": 0 } },
    { "name": "2. 여유 10분", "fn": "calcDay", "route": "A", "day": 1, "commute": { "bufferMin": 10 },
      "classes": [{ "day": 1, "start": "09:00", "end": "10:15" }],
      "expect": { "status": "ok", "bus": "07:25", "wake": "06:40" } },
    { "name": "3. 탑승 한계 = 버스 시각", "fn": "calcDay", "route": "A", "day": 1, "commute": { "walkToRoomMin": 15 },
      "classes": [{ "day": 1, "start": "09:00", "end": "10:15" }],
      "expect": { "boardLimit": "08:05", "bus": "08:05" } },
    { "name": "4. 수업 없는 날", "fn": "calcDay", "route": "A", "day": 2,
      "classes": [{ "day": 1, "start": "09:00", "end": "10:15" }],
      "expect": { "status": "no-class" } },
    { "name": "5. 공강 — 첫 수업 기준", "fn": "calcDay", "route": "A", "day": 1,
      "classes": [{ "day": 1, "start": "13:00", "end": "14:15" }, { "day": 1, "start": "09:00", "end": "10:15" }],
      "expect": { "status": "ok", "classStart": "09:00", "wake": "07:20" } },
    { "name": "6. 토요일", "fn": "calcDay", "route": "A", "day": 6,
      "classes": [{ "day": 6, "start": "10:00", "end": "11:00" }],
      "expect": { "status": "ok", "bus": "08:30", "wake": "07:45" } },
    { "name": "7. 일요일", "fn": "calcDay", "route": "A", "day": 0,
      "classes": [{ "day": 0, "start": "12:00", "end": "13:00" }],
      "expect": { "status": "ok", "bus": "11:00", "wake": "10:15" } },
    { "name": "8. 첫차 지각", "fn": "calcDay", "route": "C", "day": 1,
      "classes": [{ "day": 1, "start": "08:00", "end": "09:15" }],
      "expect": { "status": "late", "bus": "07:10", "lateMin": 13, "wake": "06:25" } },
    { "name": "9. 자정 넘김", "fn": "calcDay", "route": "NIGHT", "day": 1,
      "commute": { "prepMin": 30, "walkToStopMin": 10, "walkToRoomMin": 5 },
      "classes": [{ "day": 1, "start": "01:00", "end": "02:00" }],
      "expect": { "status": "ok", "bus": "00:20", "wake": "전날 23:40" } },
    { "name": "10. 그 요일 버스 없음", "fn": "calcDay", "route": "WEEKDAY_ONLY", "day": 0,
      "classes": [{ "day": 0, "start": "10:00", "end": "11:00" }],
      "expect": { "status": "no-bus" } },
    { "name": "11. 출발 정각 = on-time", "fn": "checkNow", "route": "A", "day": 1, "now": "08:00",
      "classes": [{ "day": 1, "start": "09:00", "end": "10:15" }],
      "expect": { "status": "on-time" } },
    { "name": "12. 버스 놓침", "fn": "checkNow", "route": "A", "day": 1, "now": "08:01",
      "classes": [{ "day": 1, "start": "09:00", "end": "10:15" }],
      "expect": { "status": "missed", "nextBus": "08:45", "lateMin": 33 } },
    { "name": "13. 막차 놓침", "fn": "checkNow", "route": "A", "day": 1, "now": "20:58",
      "classes": [{ "day": 1, "start": "09:00", "end": "10:15" }],
      "expect": { "status": "no-more-bus" } },
    { "name": "14. 수업 없는 날 checkNow", "fn": "checkNow", "route": "A", "day": 3, "now": "10:00",
      "classes": [],
      "expect": { "status": "none" } },
    { "name": "15. 이동 시간 모드 (준비 40 · 이동 37 · 여유 10)", "fn": "calcDay", "route": "A", "day": 1,
      "commute": { "travelMin": 37, "bufferMin": 10 },
      "classes": [{ "day": 1, "start": "09:00", "end": "10:15" }],
      "expect": { "status": "ok", "arriveTarget": "08:50", "departure": "08:13", "wake": "07:33" } },
    { "name": "16. 이동 시간 모드 — 공강이 있어도 첫 수업 기준", "fn": "calcDay", "route": "A", "day": 1,
      "commute": { "travelMin": 37, "bufferMin": 10 },
      "classes": [{ "day": 1, "start": "13:00", "end": "14:15" }, { "day": 1, "start": "10:30", "end": "11:45" }],
      "expect": { "departure": "09:43", "wake": "09:03" } },
    { "name": "17. 이동 시간 모드 — 자정 넘김", "fn": "calcDay", "route": "A", "day": 1,
      "commute": { "prepMin": 120, "travelMin": 300, "bufferMin": 10 },
      "classes": [{ "day": 1, "start": "07:00", "end": "08:00" }],
      "expect": { "departure": "01:50", "wake": "전날 23:50" } },
    { "name": "18. 이동 시간 모드 — 출발 정각 = on-time", "fn": "checkNow", "route": "A", "day": 1, "now": "08:13",
      "commute": { "travelMin": 37, "bufferMin": 10 },
      "classes": [{ "day": 1, "start": "09:00", "end": "10:15" }],
      "expect": { "status": "on-time" } },
    { "name": "19. 이동 시간 모드 — 늦게 출발 (08:30 → 09:07 도착, 7분 지각)", "fn": "checkNow", "route": "A", "day": 1, "now": "08:30",
      "commute": { "travelMin": 37, "bufferMin": 10 },
      "classes": [{ "day": 1, "start": "09:00", "end": "10:15" }],
      "expect": { "status": "missed", "arrival": "09:07", "lateMin": 7 } },
    { "name": "20. 이동 시간 모드 — 여유만 줄어든 출발 (08:20 → 지각 아님)", "fn": "checkNow", "route": "A", "day": 1, "now": "08:20",
      "commute": { "travelMin": 37, "bufferMin": 10 },
      "classes": [{ "day": 1, "start": "09:00", "end": "10:15" }],
      "expect": { "status": "missed", "arrival": "08:57", "lateMin": 0 } }
  ]
}
